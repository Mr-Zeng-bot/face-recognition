# ============================================================================
# .gitignore —— 只提交源码与文档
# 过滤运行时配置、构建产物、抓拍图片与大体积模型权重，避免仓库膨胀与口令外泄。
# ============================================================================

# 运行时配置：含 MySQL 账号与 DPAPI 密文，禁止提交
/config.ini

# 构建产物（含全部 exe/dll/obj 与部署副本，体积以 GB 计）
/build/

# 海康 MVS SDK（专有，禁止再分发；本机安装 SDK 后由 QT_Face.pro 自动探测）
/include/
/lib/

# qmake / moc / uic 生成物
/Makefile
/Makefile.*
/*.qmake.stash
/ui_*.h
*.obj
*.pdb
*.exp
*.ilk

# 抓拍图片与录像
/captures/

# 模型权重（体积大，随发行部署包提供，不入库；.param/README/转换脚本仍入库）
/models/*.bin

# IDE 用户配置
/.qtcreator/

# 打包产物
*.zip
