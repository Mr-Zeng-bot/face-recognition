# ============================================================================
# .gitignore —— 只提交源码与文档
# 过滤运行时配置、构建产物、抓拍图片与大体积模型权重，避免仓库膨胀与口令外泄。
# ============================================================================

# 运行时配置：含 MySQL 账号与 DPAPI 密文，禁止提交
/config.ini

# 构建产物（含全部 exe/dll/obj 与部署副本，体积以 GB 计）
/build/

# 海康 MVS SDK（专有，禁止再分发；本机安装 SDK 后由 QT_Face.pro 自动探测）
/include/
/lib/

# qmake / moc / uic 生成物
/Makefile
/Makefile.*
/*.qmake.stash
/ui_*.h
*.obj
*.pdb
*.exp
*.ilk

# 抓拍图片与录像（无论运行时目录配置在哪里都不入库）
captures/

# InsightFace 模型产物仅限非商业研究，且体积较大，不入公开仓库。
# 仓库只保留 README 与转换脚本，用户按说明自行下载和转换。
/models/*.param
/models/*.bin
/models/*.onnx
/models/*.pnnx.*
/models/*.ncnn.*

# IDE 用户配置（Qt Creator 工程配置含本机路径与套件，禁止提交）
/.qtcreator/
*.pro.user
*.pro.user.*

# 打包产物
*.zip
